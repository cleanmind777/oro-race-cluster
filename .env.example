# Copy to .env and edit. Both Python programs and the PM2 files read it.
#   cp .env.example .env
# Apply edits with `pm2 start ecosystem.main.cjs` (or ecosystem.worker.cjs): PM2 keeps
# the environment an app was started with, so a plain `pm2 restart` reuses old values.
# A real environment variable wins for a one-off override:
#   ORO_MAX_RPM=40 pm2 restart oro-worker --update-env
#
# A  # starts a comment, so quote any value that needs one: PASSWORD="a # b"
#
# .env is gitignored. Keep it out of backups you share.


# =============================================================================
# MAIN VPS
# =============================================================================

# The only listening socket in the cluster. It serves BOTH the dashboard and the
# worker routes, which is why the two are gated separately below.
# Use 0.0.0.0 to reach the dashboard from anywhere, or 127.0.0.1 when a reverse
# proxy on this machine terminates HTTPS, or a Tailscale/VPN address.
BIND_HOST=0.0.0.0
BIND_PORT=8080

# ---- ACCESS CONTROL ---------------------------------------------------------
# Main has two route groups on this one port, gated independently:
#
#   WORKER routes  GET /api/work, PUT /api/upload, POST /api/work/...
#                  -> ALLOWED_IPS (+ CLUSTER_TOKEN if set). These write into
#                     your dataset, so they are never opened to the public.
#   DASHBOARD      the UI, /api/status, /api/workers, POST /api/races
#                  -> UI_USER + UI_PASSWORD (+ UI_ALLOWED_IPS if set)
#
#   GET /api/health is deliberately open for uptime checks.
#
# A dashboard login grants NO upload rights, and a worker token grants no
# dashboard access.

# Which IPs may use the WORKER routes. Comma separated IPs and/or CIDR blocks.
# 127.0.0.0/8 and ::1 are always allowed, so main's own worker and CLI work.
# List every extra VPS's PUBLIC IP (on each: curl -s https://api.ipify.org).
# Blocked requests get 403 naming the IP main saw, logged once per IP a minute.
# Empty = any IP may upload. Do not leave it empty on a public port.
ALLOWED_IPS=203.0.113.20, 198.51.100.30

# Dashboard login (HTTP Basic). Empty UI_USER = no login at all, which on a
# public port means anyone can view progress and start races.
# NOTE: Basic credentials are only base64-encoded, so on a public HTTP port they
# are effectively cleartext. Put main behind an HTTPS reverse proxy, or keep the
# dashboard on a VPN/SSH tunnel, if that matters to you.
UI_USER=admin
UI_PASSWORD=change-this-long-and-random

# Optional extra restriction for the dashboard. Empty = reachable from any IP
# (that is the point of a public UI port). Set it to lock the UI down too.
UI_ALLOWED_IPS=

# Failed-login brake: after UI_MAX_FAILS wrong passwords from one IP, further
# wrong guesses get 429 for UI_BAN_SEC seconds. The CORRECT password always
# works, so nobody can lock you out of your own dashboard.
UI_MAX_FAILS=10
UI_BAN_SEC=300

# Optional shared secret for the WORKER routes, sent as X-Cluster-Token.
# Empty = disabled. Not needed when ALLOWED_IPS is set and your firewall is
# right; set it for defence in depth (then every worker's .env needs it too).
CLUSTER_TOKEN=

# Set to 1 ONLY if main sits behind your own reverse proxy on this machine.
# It then trusts the last X-Forwarded-For entry from a loopback/private peer as
# the real client IP, which is what ALLOWED_IPS is then matched against.
# Requires `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;` in
# nginx. Never enable it on a directly exposed port: a client could forge the
# header and bypass ALLOWED_IPS.
TRUST_PROXY=0

# Where race files are written. Only ever on main.
DATA_DIR=./Data/races

# After a race download finishes, rebuild task_dictionary.json from the race
# logs (writes ORO_LOGS + oro_local_store/Data/tasks/). Set to 0 to disable.
UPDATE_TASK_DICTIONARY=1
TASK_DICTIONARY_SCRIPT=/home/new_oro/ORO_LOGS/build_task_dictionary.py
# TASK_DICTIONARY_TIMEOUT_SEC=600
# After rebuild, commit + push ORO_LOGS with message "add: Race <n>".
# Uses SSH (git@github.com:...). Set to 0 to disable.
PUSH_ORO_LOGS=1
ORO_LOGS_GIT_DIR=/home/new_oro/ORO_LOGS
# ORO_LOGS_GIT_TIMEOUT_SEC=3600

# Requests per minute for main's METADATA fetch. The public cap is ~100 per
# PUBLIC IP, and on main two processes share one IP: oro-main (this value) and
# main's local worker (ORO_MAX_RPM further down). Hence ~49 each.
MAIN_ORO_MAX_RPM=49

# Continue an interrupted race automatically when oro-main starts again, which
# covers a crash, a `pm2 restart` and a reboot. The race_id and label are kept
# in .oro-main-state.json next to oro_main.py; files already on disk are
# skipped, so a resume costs only the metadata requests. Stopping a race from
# the dashboard or with `python3 oro_main.py stop` clears it, so a stop stays
# stopped. Set to 0 to always start races by hand.
AUTO_RESUME=1

# ORO publishes a race's logs some hours after it ends. Main does not refuse
# such a race: it enters the "waiting" phase, polls the race and probes a few
# episodes every WATCH_INTERVAL_SEC, and starts the cluster by itself the
# moment the logs appear. Nothing is downloaded while it waits.
#   WATCH_REQUIRE_COMPLETE=1  also wait for race.status == RACE_COMPLETE
#   PROBE_EPISODES            episodes tried per check; one success is enough,
#                             so a single missing artifact cannot block a start
WATCH_INTERVAL_SEC=60
WATCH_REQUIRE_COMPLETE=1
PROBE_EPISODES=3

# Give up on a single file after this many failed attempts, so one episode that
# is permanently missing (404) cannot keep a race from finishing. Gone-for-good
# files are counted as "unavailable" in the dashboard.
MAX_ITEM_FAILURES=3

# Scheduling (safe to leave alone)
# Metadata (runs.json, evaluation_run.json) is handed out in small units too,
# before any episode, so every VPS helps with it instead of main doing it alone.
UNIT_MAX_EPISODES=20
UNIT_MAX_META=4
UNIT_STALE_SEC=180


# =============================================================================
# EVERY WORKER (main's local one and each extra VPS)
# =============================================================================

# Extra VPS only: main's address INCLUDING the port. Uncomment and set it there.
#   http://203.0.113.10:8080      direct
#   http://100.x.y.z:8080         over Tailscale/VPN
#   https://main.example.com      behind an HTTPS reverse proxy
# LEAVE IT COMMENTED OUT ON MAIN: main's local worker then follows BIND_PORT by
# itself. Pointing it at another host would send main's own downloads away.
# MAIN_URL=http://203.0.113.10:8080

# Unique name for this machine, shown as a row in the dashboard.
# Commented out = this machine's hostname; on main the PM2 file uses "local".
# WORKER_ID=vps-fra-1

# Parallel downloads on this machine, all sharing one rate limiter.
WORKER_THREADS=4

# This machine's own cap toward ORO. Lower it if this VPS already calls the ORO
# API for something else - it will simply pull fewer units.
# On main set 49, because oro-main uses the other half of that IP's budget.
ORO_MAX_RPM=98

# Windows: the interpreter PM2 should use. Usually "python", or a full path.
# PYTHON=python
